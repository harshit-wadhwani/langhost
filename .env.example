LANGGRAPH_RUNTIME_EDITION=pg
DATABASE_URI=postgresql+asyncpg://postgres:postgres@localhost:5432/langgraph
REDIS_URI=redis://localhost:6379/0
# Optional: redis-py client pool size (default 64). Fanout uses 2 shared
# pattern subscriptions + 1 wake listener; raise only if you have many replicas
# sharing one process pool incorrectly.
# REDIS_MAX_CONNECTIONS=64
